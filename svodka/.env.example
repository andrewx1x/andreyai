# ============================================================
# Сводка — Environment Variables
# Copy to .env.local and fill in real values
# ============================================================

# --- Database (Turso / LibSQL) ---
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# --- NextAuth ---
# Generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
# Required for production:
NEXTAUTH_URL=http://localhost:3000

# --- Yandex OAuth ---
# Create app at https://oauth.yandex.ru/
# Scopes: login:info login:email metrika:read direct:api
YANDEX_CLIENT_ID=your-yandex-app-id
YANDEX_CLIENT_SECRET=your-yandex-app-secret

# --- Encryption (AES-256-GCM for OAuth tokens) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=your-64-char-hex-key-here

# --- Email (Resend) ---
# Get key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address (requires verified domain in Resend)
# EMAIL_FROM=Сводка <alerts@svodka.app>

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dev Banner ---
# Set to "true" to show "site in development" banner
# NEXT_PUBLIC_DEV_BANNER=true

# --- Yandex Metrika (for tracking the product itself) ---
# Create counter at https://metrika.yandex.ru/
# NEXT_PUBLIC_YM_ID=12345678

# --- Cron Authentication ---
# Used to protect /api/cron/* endpoints
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# --- ЮKassa (Payment) ---
# Will be configured on Timeweb after legal docs
# Get credentials at https://yookassa.ru/my/shop-settings
# YUKASSA_SHOP_ID=your-shop-id
# YUKASSA_SECRET_KEY=your-secret-key
# YUKASSA_ENABLED=true
