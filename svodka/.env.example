# ============================================================
# Сводка — Environment Variables
# Copy to .env.local and fill in real values
# ============================================================

# --- Database (локальный SQLite на VPS) ---
TURSO_DATABASE_URL=file:/root/andreyai/svodka/data/svodka.db

# --- NextAuth ---
# Generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
# Required for production:
NEXTAUTH_URL=https://app.andreyai.ru

# --- Yandex OAuth ---
# Create app at https://oauth.yandex.ru/client/new
# Redirect URI: https://app.andreyai.ru/api/auth/callback/yandex
# Scopes: login:info login:email metrika:read direct:api
YANDEX_CLIENT_ID=your-client-id
YANDEX_CLIENT_SECRET=your-client-secret

# --- Encryption (AES-256-GCM for OAuth tokens) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=your-64-char-hex-key-here

# --- Email (SMTP — Timeweb) ---
# Настроить в панели Timeweb → Почта
# SMTP_HOST=smtp.timeweb.ru
# SMTP_PORT=465
# SMTP_USER=alerts@andreyai.ru
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=Сводка <alerts@andreyai.ru>

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.andreyai.ru

# --- Dev Banner ---
# Set to "true" to show "site in development" banner
# NEXT_PUBLIC_DEV_BANNER=true

# --- Yandex Metrika (for tracking the product itself) ---
# Create counter at https://metrika.yandex.ru/
# NEXT_PUBLIC_YM_ID=12345678

# --- Cron Authentication ---
# Used to protect /api/cron/* endpoints
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# --- ЮKassa (Payment) ---
# Get credentials at https://yookassa.ru/my/shop-settings
# YUKASSA_SHOP_ID=your-shop-id
# YUKASSA_SECRET_KEY=your-secret-key
# YUKASSA_ENABLED=true
